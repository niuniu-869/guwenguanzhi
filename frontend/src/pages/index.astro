---
import BaseLayout from '../layouts/BaseLayout.astro';
import DynastyTimeline from '../components/DynastyTimeline.astro';
import DynastyStation from '../components/DynastyStation.astro';
import { getDynastyStations, PRIMARY_BOOK_ID, getBook } from '../lib/books';

const stations = getDynastyStations();
const book = getBook(PRIMARY_BOOK_ID);

const totalDocs = stations.reduce((s, x) => s + x.totalDocs, 0);
const totalAuthors = stations.reduce((s, x) => s + x.totalAuthors, 0);
const dynastyCount = stations.length;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const authorsHref = `${base}/authors`;
---

<BaseLayout
  title="古文观之"
  description="循着中国历史读古文：古文观止 222 篇经典，按朝代串联，逐句翻译，逐词注释"
>
  {/* Hero */}
  <section class="relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-10 text-center relative z-10">
      <div
        class="text-7xl font-serif text-border-light select-none leading-none mb-[-0.5rem]"
        aria-hidden="true"
      >
        “
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-[0.2em] text-ink">
        古文观之
      </h1>
      <p class="mt-4 text-ink-light text-base sm:text-lg tracking-widest">
        循着中国历史，读 一 篇 古 文
      </p>
      <p class="mt-2 text-sm text-ink-faint max-w-xl mx-auto leading-relaxed">
        {book?.summary ?? ''}
      </p>
      <div class="mt-5 flex items-center justify-center gap-5 text-xs text-ink-faint">
        <span>{dynastyCount} 朝</span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span>{totalAuthors} 位作者</span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span>{totalDocs} 篇</span>
      </div>
    </div>
  </section>

  {/* 吸顶时间轴 */}
  <DynastyTimeline stations={stations} />

  {/* 朝代驿站 */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
    {stations.map((s) => (
      <DynastyStation station={s} />
    ))}
  </section>

  {/* 底部：按作者浏览入口 */}
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16 pt-10">
    <div class="rounded border border-border-light bg-card px-6 py-7 sm:flex items-center justify-between gap-6">
      <div>
        <h3 class="font-serif text-xl text-ink mb-1">想找熟悉的那位？</h3>
        <p class="text-sm text-ink-light">
          按朝代分组浏览全部 {totalAuthors} 位作者，从左丘明到张溥。
        </p>
      </div>
      <a
        href={authorsHref}
        class="mt-4 sm:mt-0 inline-flex items-center gap-2 px-5 py-2.5 border border-ink text-ink hover:bg-ink hover:text-paper transition-colors no-underline rounded text-sm tracking-wider"
      >
        按作者浏览 →
      </a>
    </div>
  </section>
</BaseLayout>
