---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = '古文观止', description = '古文观止全文翻译 · 逐句翻译 · 逐词注释' } = Astro.props;
const fullTitle = title === '古文观止' ? title : `${title} · 古文观止`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen">
    <!-- 顶部导航 -->
    <header class="border-b border-border-light">
      <nav class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 text-ink no-underline hover:opacity-80 transition-opacity">
          <span class="font-serif text-lg font-semibold tracking-wider">古文观止</span>
        </a>
        <div class="flex items-center gap-4 text-sm text-ink-light">
          <a href={import.meta.env.BASE_URL} class="hover:text-ink transition-colors no-underline">首页</a>
          <a
            href="https://github.com/niuniu-869/guwenguanzhi"
            target="_blank"
            rel="noopener"
            class="hover:text-ink transition-colors no-underline"
          >
            GitHub
          </a>
        </div>
      </nav>
    </header>

    <!-- 主内容 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="border-t border-border-light mt-auto">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 text-center text-sm text-ink-faint">
        <p>古文观止 · 开源古文学习工具</p>
        <p class="mt-1">翻译内容由 AI 生成，仅供参考学习</p>
        <p class="mt-1">模型由 <a href="https://platform.xiaomimimo.com" target="_blank" rel="noopener" class="text-ink-light hover:text-cinnabar transition-colors">platform.xiaomimimo.com</a> 赞助</p>
      </div>
    </footer>
  </body>
</html>
