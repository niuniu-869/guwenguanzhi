---
/**
 * 首页吸顶时间轴
 * 横向 6 朝代锚点；点击平滑滚动到对应 station
 */
import type { DynastyStation } from '../lib/types';

interface Props {
  stations: DynastyStation[];
}

const { stations } = Astro.props;
---

<nav class="dynasty-timeline sticky top-0 z-30 bg-paper/90 backdrop-blur border-b border-border-light">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <ol class="flex items-center gap-1 sm:gap-2 overflow-x-auto no-scrollbar">
      {stations.map((s, i) => (
        <>
          {i > 0 && (
            <li aria-hidden="true" class="shrink-0 w-4 sm:w-8 h-px bg-border-light"></li>
          )}
          <li class="shrink-0">
            <a
              href={`#${s.id}`}
              class="dynasty-pill group inline-flex items-baseline gap-2 px-3 py-1.5 rounded-full text-sm transition-all"
              style={`--accent: ${s.color}`}
            >
              <span
                class="w-1.5 h-1.5 rounded-full"
                style={`background: var(--accent)`}
              ></span>
              <span class="font-serif font-semibold tracking-wide text-ink">
                {s.name}
              </span>
              <span class="text-[0.6875rem] text-ink-faint hidden sm:inline">
                {s.totalDocs}
              </span>
            </a>
          </li>
        </>
      ))}
    </ol>
  </div>
</nav>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .dynasty-pill:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
</style>
